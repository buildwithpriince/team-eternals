# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL
SUPABASE_URL="MY_SUPABASE_URL"

# SUPABASE_SERVICE_ROLE_KEY: Server-side key for backend writes (interviews, documents, red-flag updates) — never expose this to the frontend
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# SUPABASE_ANON_KEY: Client-side key for the doctor dashboard's auth session and realtime subscription only
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
